{
  "name": "accesshub-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace=backend",
    "dev": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "typecheck": "npm run typecheck --workspace=backend",
    "build:extension": "npm --prefix extension run build",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend --",
    "db:deploy": "npm run db:deploy --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend"
  }
}
